# --- Market data (optional) -------------------------------------------------
# Without any provider the ticker renders sample data and labels itself
# "SAMPLE", so placeholder numbers are never shown as real quotes.
#
# Preferred: Alpaca. One batch request covers every symbol.
# Free keys (paper trading account is enough): https://app.alpaca.markets/signup
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional. Set to "delayed_sip" for full-market 15-minute delayed data
# instead of your plan's default feed. Leave blank to use the default.
ALPACA_FEED=

# Fallback provider, used only when no Alpaca credentials are present.
# Costs one request per symbol instead of one per refresh.
FINNHUB_API_KEY=

# --- Site ---------------------------------------------------------------------
# Absolute base URL for canonical tags, OpenGraph and the sitemap.
# Only needed with a custom domain — on Vercel this falls back to the
# project's production URL automatically. No trailing slash.
NEXT_PUBLIC_SITE_URL=
