# Live quotes for the top ticker strip.
# Free key: https://finnhub.io/register
# Without this the ticker renders sample data and labels itself "SAMPLE".
FINNHUB_API_KEY=

# Absolute base URL used for canonical tags, OpenGraph and the sitemap.
# Only needed once you attach a custom domain — on Vercel this falls back to
# the project's production URL automatically. No trailing slash.
NEXT_PUBLIC_SITE_URL=
